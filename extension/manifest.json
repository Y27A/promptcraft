{
  "manifest_version": 3,
  "name": "PromptCraft",
  "version": "1.0.0",
  "description": "Generate perfect AI prompts on any AI tool — ChatGPT, Claude, Gemini & more.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://poe.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PromptCraft"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://poe.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
