# ===== SERVER (.env in /server) =====
DATABASE_URL=postgresql://user:password@host:5432/promptcraft?sslmode=require
# Set to "false" only if your database provider serves a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Required in production — generate with: openssl rand -hex 32
SESSION_SECRET=replace-this-with-a-random-32-char-string
CLERK_SECRET_KEY=sk_live_...
CLERK_PUBLISHABLE_KEY=pk_live_...
GROQ_API_KEY=gsk_...
ALLOWED_ORIGINS=https://y27a.github.io
NODE_ENV=production
PORT=10000

# ===== WORKER (wrangler secret put GROQ_API_KEY) =====
# GROQ_API_KEY is stored as a Cloudflare Worker secret — never in client env vars.

# ===== CLIENT (GitHub repo secrets) =====
# Anything prefixed VITE_ is embedded in the public bundle. Never put an API key here.
VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
VITE_API_BASE_URL=https://your-app-name.onrender.com
VITE_PROXY_URL=https://promptcraft-proxy.<subdomain>.workers.dev
